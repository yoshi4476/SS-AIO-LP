# 認証情報（絶対にコミットしない）
.env
credentials.json
sheets-token.json
indexing-service-account.json
*.pem
*.key

# 収集データ・ログ（容量大・再生成可能）
data/x_trends/
data/youtube_transcripts/
automation/logs/*
# 介入の台帳は週次の効果測定・戻しが過去分を読むので追跡する（CI では毎回空になっていた）
!automation/logs/auto_fix.jsonl
automation/images/

# OS/エディタ
.DS_Store
Thumbs.db
__pycache__/
.wrangler/

# 配信先リポジトリの作業クローン
.publish-work/

# 支給された写真の原本（サイトへは site/images/ へ書き出したものを載せる）
写真素材/

# 管制塔のURLと合言葉を埋め込んだ貼り付け用コード（配布物ではない）
automation/gas/*.ready.gs
# .env の控え（認証情報を含むため）
.env.backup-*

# 認証情報の一括反映に使う控え（絶対にコミットしない）
secrets.local.txt

# ヒアリングシートには会社名・住所・電話・担当者のメールが入る。
# このリポジトリは public のため、置いたまま commit すると誰でも読める。
# 取り込みは手元で実行し、生成された sites/*.json だけを commit する
intake/*.xlsx
intake/done/
intake/todo/
# シートの「レポートの送付先」（担当者のメール）と「その他の申し送り」（社内事情）。
# sites/*.json に入れると公開されるため、ここに分けて置く（client_intake.to_private）
data/clients/*/private.json
# 最初の接続の点検の結果（onboard_check.py）。お客様のサイトの抜けと先方に頼むことが入るので public に置かない。
# 自社3サイトの分（data/onboard/<id>.json）はコミットする
data/clients/*/onboard.json
# 機能ごとの準備状況（intake_readiness.py）。先方に頼むことと鍵の受け渡しの状況が入るので public に置かない
data/clients/*/readiness.json

# ラッコの応答のキャッシュ（課金を減らすための手元の控え。公開リポジトリには置かない）
data/rakko_cache/
data/rakko_volume.json
data/rakko_spend.jsonl
# Bing への送信記録（同じ日に二度送らないため）。CI ではキャッシュで持ち越す
data/bing_submit.json
docs/kw-plan-*.dry.md

# GSCから取り直せる派生キャッシュ（112KB・週次で全書き換え）
data/rank_rescue.json
# YouTube への投稿に使う鍵。**このリポジトリは public なので必ず除外する。**
# OAuth クライアントとトークンが漏れると、チャンネルへ投稿されうる
youtube-client.json
youtube-token.json
youtube-token-*.json
credentials/
# 動画は作り直せるので追跡しない（1本2〜4MB）
automation/video/
automation/proposal.html
automation/insta/
# Googleビジネスプロフィールの鍵（クライアントごと）。公開リポジトリなので絶対にコミットしない
gbp-client.json
gbp-token-*.json
# URLから作ったヒアリングの下書き（先方の会社情報が入る）
intake/下書き/
# 口コミの返信案（投稿者の名前・本文が入る。公開リポジトリには置かない）
data/reviews/
# 言及の依頼の宛先・連絡先・下書き・送った記録（outreach.py）。公開リポジトリには置かない
data/outreach/

# 社ごとのSNSの鍵（social_connect.py の控え。GitHub では SOCIAL_TOKENS_JSON）
social-tokens.json
automation/note/
# data/research/*-raw.json はコミットする（2026-10-05）。CI で ChatGPT の欠けた問いだけを聞き足すには、
# 既にある答えが要る。中身は出典のURLとエラーだけで、答えの本文は入っていない
# 出典のドメインの種類（手で確かめた直しを含む）はコミットする。CI で調べ直すとき、直しが消えて数字が変わらないように
.dev.vars

# FTP の接続情報・ZIP 納品物（先方の資格情報と納品物は公開リポジトリに置かない）
ftp-credentials.json
deliveries/
# 競合比較（compete.py）。お客様の分（競合の顔ぶれ・自社の順位・負けている語）は public に置かない。
# 自社3サイトと月の問い合わせ回数だけをコミットし、お客様の分は CI のキャッシュで月をまたぐ
data/compete/*
!data/compete/ai-lab/
!data/compete/corporate/
!data/compete/subsidy/
!data/compete/_usage.json
# Bing の検索の成績（bing_webmaster.py --stats）。お客様の分（検索語・ページ・回数）は public に置かず、CI のキャッシュで持ち越す
data/bing_stats/*
!data/bing_stats/ai-lab.json
!data/bing_stats/corporate.json
!data/bing_stats/subsidy.json
