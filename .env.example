# ============================================================
# .env 雛形（静的HTML + Cloudflare Pages 版）
# この内容を .env にコピーし、実際の値を設定する
# ※旧 .env の WP_URL / WP_USER / WP_PASSWORD は不要（WordPress不使用）
# ============================================================

# サイト（ドメイン取得後に差し替え）
SITE_URL=https://example.com

# X(Twitter) API v2
X_BEARER_TOKEN=YOUR_X_BEARER_TOKEN
X_API_KEY=YOUR_X_API_KEY
X_API_SECRET=YOUR_X_API_SECRET

# YouTube Data API v3
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEETS_TOKEN_PATH=./sheets-token.json
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Google Indexing API
INDEXING_SERVICE_ACCOUNT_PATH=./indexing-service-account.json

# IndexNow（オプション: Bing/Copilot/Perplexity系対策）
INDEXNOW_KEY=YOUR_INDEXNOW_KEY

# Ahrefs（MCP経由: .mcp.json の env に設定。直接API利用時のみここに設定）
AHREFS_API_KEY=YOUR_AHREFS_API_KEY

# 画像生成（NanoBanana or Gemini）
NANOBANANA_API_KEY=YOUR_NANOBANANA_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google Analytics（KPIレポート用+AI参照元計測）
GA4_PROPERTY_ID=YOUR_GA4_PROPERTY_ID

# Google Search Console
GSC_SITE_URL=YOUR_GSC_SITE_URL
